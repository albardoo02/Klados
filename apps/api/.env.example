PORT=8080
DATABASE_URL=host=localhost user=klados password=klados dbname=klados port=5432 sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-use-long-random-string
# Media Storage: "local" (default, self-contained within API) or "s3"
STORAGE_DRIVER=local
STORAGE_DIR=/data/media

# S3 / MinIO Settings (Only active if STORAGE_DRIVER=s3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=klados-media
MINIO_USE_SSL=false
ALLOW_ORIGINS=http://localhost:3000
ENVIRONMENT=development